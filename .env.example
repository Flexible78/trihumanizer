# TriHumanizer Translator — environment configuration
# Copy this file to `.env` locally and fill in your own values.
# NEVER commit the real .env file.

# ---- Provider API keys (server-side only, never sent to the browser) ----
# Mistral is the default provider; MISTRAL_API_KEY makes it work out of the box.
MISTRAL_API_KEY=
GROQ_API_KEY=
GOOGLE_STUDIO_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=
FREEWAY_API_KEY=
OPENAI_API_KEY=

# ---- Local server ----
# Port used by the local launcher (default 8868).
TRIHUMANIZER_PORT=8868

# ---- Optional single-user protection for AI features ----
# When APP_PASSWORD is set, AI endpoints require a password login.
# FLASK_SECRET_KEY signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_PASSWORD=
FLASK_SECRET_KEY=

# ---- Optional live research adapter (provider-independent) ----
# RESEARCH_ENABLED=1 activates the research mode / research-powered writing.
# RESEARCH_PROVIDER: any provider id from the catalog (e.g. mistral, openrouter)
#   or "custom" together with RESEARCH_BASE_URL.
# The research provider must be able to perform web search; otherwise it only
# returns facts already available to it and marks what needs verification.
RESEARCH_ENABLED=0
RESEARCH_PROVIDER=
RESEARCH_MODEL=
RESEARCH_API_KEY=
RESEARCH_BASE_URL=

# ---- Hosted mode (set automatically by Vercel) ----
# Set TRIHUMANIZER_HOSTED=1 to disable server-side SQLite history and control
# routes; the browser keeps history in localStorage instead.
# TRIHUMANIZER_HOSTED=0
